# Copy to .env (gitignored) and fill in. Loaded by jobagent.config.
# Never commit .env - it holds the DeepSeek key and the worker token.

# --- LLM ---------------------------------------------------------------------
# DeepSeek: OpenAI-compatible. Base URL matters; the model id must be literal
# (`deepseek-chat` is only an alias and can be repointed server-side).
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_MODEL_ESCALATE=deepseek-v4-pro

# --- Mail worker (inbound only) ---------------------------------------------
# AGENT_TOKEN is a Cloudflare secret: npx wrangler secret put AGENT_TOKEN
# Leave blank and doctor still passes: it verifies the worker is reachable and
# that auth is enforced (expects 401 without a token).
AGENT_TOKEN=
MAIL_WORKER_BASE=https://my-email-worker.flso.workers.dev

# --- Addresses ---------------------------------------------------------------
# The one canonical human-facing address used on every application and resume.
JOBAGENT_CONTACT_ADDRESS=favourotiger@toesk.uk

# --- Local models (Ollama) ---------------------------------------------------
OLLAMA_BASE=http://localhost:11434
OLLAMA_CLASSIFY_MODEL=qwen3:8b
OLLAMA_FAILOVER_MODEL=qwen3:14b
OLLAMA_EMBED_MODEL=bge-m3

# --- Budget (hard caps; balance was $7.54) -----------------------------------
JOBAGENT_MAX_COST_PER_RUN_USD=1.00
JOBAGENT_MAX_COST_PER_DAY_USD=3.00

# --- Paths (repo-relative) ---------------------------------------------------
JOBAGENT_STATE_DIR=state
JOBAGENT_ARTIFACTS_DIR=artifacts
